# --- Google Gemini API Key (optional — heuristic fallback runs without it) ---
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite

# --- Server Configuration ---
HOST=127.0.0.1
PORT=8000
DEBUG=True

# --- Auth / Session ---
# REQUIRED before deploying anywhere real: a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Anyone who enters this code at sign-up is granted EDITOR (newsroom triage)
# clearance. Keep it secret; share only with your judges/team as needed.
EDITOR_INVITE_CODE=editor

# --- OTP behaviour ---
OTP_RATE_LIMIT_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_MAX_VERIFY_ATTEMPTS=5

# --- Trust & Verification Parameters ---
SPATIAL_CLUSTER_RADIUS_METERS=500
VERIFICATION_THRESHOLD=75
COMMUNITY_HAZARD_THRESHOLD=35
MAX_STRIKES_BEFORE_QUARANTINE=3

# --- Optional real email delivery for OTP codes ---
# Leave blank to run in DEBUG dev-mode: codes are printed to the terminal AND
# returned to the browser so login always works without any email service —
# ideal for a hackathon demo. Fill these in (e.g. a Gmail App Password) to
# send real emails instead; the app auto-detects and switches over.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
